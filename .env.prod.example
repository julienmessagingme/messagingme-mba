# .env.prod — à créer SUR LE VPS (jamais commité). Chargé par mba-api et mba-worker.

NODE_ENV=production
PORT=8095

# Auth : OBLIGATOIRE en prod (>= 32 octets). Sans lui, le boot échoue.
#   openssl rand -base64 48
AUTH_SECRET=

# Surface d'exploitation cross-tenant /ops (lecture seule). Vide -> /ops désactivé (401).
# Si défini, DOIT faire >= 32 octets aléatoires : openssl rand -base64 48
OPS_TOKEN=

# Base Supabase. ATTENTION : le host DIRECT db.<ref>.supabase.co est IPv6-only et injoignable
# depuis un conteneur Docker sur le VPS. Utiliser le POOLER (IPv4) :
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (port 5432 = session mode, requis par pg-boss ; PAS 6543 transaction mode).
DATABASE_URL=
# Pool APPLICATIF en mode TRANSACTION (port 6543, même host/user que DATABASE_URL). Sort les clients app du
# budget session (~15 partagé avec mm-hubspot). Vide -> repli sur DATABASE_URL (session) = comportement d'avant.
# Rollback = vider cette ligne + `docker compose up -d --force-recreate`. pg-boss NE l'utilise PAS (reste en 5432).
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
APP_DATABASE_URL=
# TLS Postgres : vérification COMPLÈTE de la chaîne (anti-MITM) via la CA Supabase (4.11). La chaîne du pooler
# est auto-signée (Supabase Root 2021 CA, absente du trust store système) ; la CA est BAKÉE dans l'image
# (certs/supabase-pooler-ca.crt -> /app/certs/, cert PUBLIC donc committé). pgSsl() (src/db/ssl.ts) : CA_FILE
# prime sur INSECURE. ROLLBACK en cas de souci TLS : retirer DB_SSL_CA_FILE et poser DB_SSL_INSECURE=true.
# ⚠️ La CA expire (Supabase Root 2021 CA -> avril 2031, intermédiaire -> oct 2033 ; échéance EFFECTIVE = 2031) :
# à renouveler avant, ou si Supabase fait tourner sa CA plus tôt (re-extraire le bundle et re-committer).
DB_SSL_CA_FILE=/app/certs/supabase-pooler-ca.crt
# DB_SSL_INSECURE=true   # chiffré mais NON vérifié : levier de rollback uniquement (sinon retiré)
# Budget de connexions. DB_POOL_MAX = pool APPLICATIF, en mode TRANSACTION (6543). PGBOSS_MAX = pg-boss, resté
# en mode SESSION, et c'est LUI qui vit dans le budget de ~15 sessions partagé avec mm-hubspot.
# Laisser vide = défauts bornés du code (8 / 2 / 8000). Ne PAS remonter sans lire src/config.ts.
DB_POOL_MAX=
PGBOSS_MAX=
DB_CONN_TIMEOUT_MS=
PGBOSS_SCHEMA=pgboss

# Démo : le worker n'appelle pas Meta et marque les envois 'sent'. Passer à false pour le live.
DRY_RUN=true

# Meta (pour le live, DRY_RUN=false) :
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
META_VERIFY_TOKEN=

# Zadarma : numéros du pool + capture de l'OTP vocal de Meta. Vides -> saisie manuelle du code.
ZADARMA_API_KEY=
ZADARMA_API_SECRET=

DEFAULT_COUNTRY=FR

# Support (formulaire de contact -> email via Resend, phase 7)
RESEND_API_KEY=
SUPPORT_FROM=onboarding@resend.dev
SUPPORT_TO=

# --- Bascule du front sur Vercel (docs/PLAN-BASCULE-VERCEL-2026-09-03.md) ---
# Les DEUX variables ci-dessous sont VIDES tant que la bascule n'est pas faite, et c'est voulu : vides, le
# comportement est celui d'avant, au caractere pres.

# URL publique de l'API quand elle repond sous SON PROPRE nom, ex. https://api.messagingme.app
# Vide -> tout retombe sur APP_URL. C'est la base des adresses que le produit DISTRIBUE : liens traces /r/,
# visuels RCS /m/, et l'URL /w/ d'un webhook entrant donnee a un tiers.
PUBLIC_API_URL=

# Origines autorisees a appeler l'API depuis un NAVIGATEUR, separees par des virgules.
# Ex. https://engageme.messagingme.app
# Vide -> AUCUN en-tete CORS n'est pose du tout. `*` est REFUSE au demarrage.
CORS_ORIGINS=
