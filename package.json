{
  "name": "messagingme-mba",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src db --pass-on-unpruned-suppressions",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "worker": "tsx src/worker-cli.ts",
    "application": "tsx src/application/service.ts",
    "migrate": "tsx db/migrate.ts",
    "migrations": "tsx db/etat.ts",
    "seed": "tsx db/seed.ts",
    "auto-attaque": "tsx scripts/auto-attaque.mts",
    "oauth:fiches": "tsx scripts/oauth-fiches.mts",
    "aide:carte": "tsx scripts/carte-console.ts",
    "aide:captures": "cd web && npx playwright test -c playwright.captures.config.ts && cd .. && node scripts/aide/captures-webp.mjs",
    "aide:charger": "tsx db/charger-aide.ts",
    "aide:proposer": "tsx scripts/aide-proposer.ts",
    "sdk:contrat": "tsx scripts/sdk-contrat.ts",
    "sdk:construire": "tsc -p sdk/tsconfig.json",
    "plugin:generer": "tsx scripts/plugin/generer.ts",
    "vitrine:entete": "tsx scripts/vitrine/entete.ts",
    "vitrine:guide-meta": "tsx scripts/vitrine/guide-meta.ts",
    "vitrine:cas": "tsx scripts/vitrine/cas.ts",
    "vitrine:anglais": "tsx scripts/vitrine/anglais.ts",
    "vitrine:aide": "tsx scripts/vitrine/aide.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@whiskeysockets/baileys": "6.7.23",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.8",
    "nodemailer": "^10.0.13",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pg-boss": "^12.25.1",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "secure-json-parse": "^4.1.0",
    "tsx": "^4.19.2",
    "undici": "^7.30.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "libsignal": "https://codeload.github.com/whiskeysockets/libsignal-node/tar.gz/bcea72df9ec34d9d9140ab30619cf479c7c144c7"
  }
}
