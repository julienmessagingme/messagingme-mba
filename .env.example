# Serveur
PORT=8095

# Meta (webhooks)
META_APP_SECRET=            # secret de l'app Meta, pour valider X-Hub-Signature-256
META_VERIFY_TOKEN=          # token du handshake de vérification du webhook
META_ACCESS_TOKEN=         # token d'envoi outbound (worker campaign-run)

# Auth console : OBLIGATOIRE en production (>= 32 octets aléatoires). Sans lui, le boot
# échoue en prod. Générer avec : openssl rand -base64 48
AUTH_SECRET=

# Surface d'exploitation cross-tenant /ops (lecture seule). Vide -> /ops désactivé (401).
# Si défini en prod, DOIT faire >= 32 octets aléatoires : openssl rand -base64 48
OPS_TOKEN=

# Base de données (Postgres local en dev/test, Supabase en prod)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mba
# TLS Postgres (sécurisé par défaut = vérif du certificat) :
#   DB_SSL_CA_FILE=/chemin/vers/supabase-ca.crt   -> vérif COMPLÈTE (cible prod)
#   DB_SSL_INSECURE=true                            -> pas de vérif (fallback dev, endpoint direct Supabase)

# Agent IA (Vercel AI Gateway). Vide -> la conversation de construction repond 503, aucun crash.
AI_GATEWAY_API_KEY=
# Provisionnement d'une cle AI Gateway PAR ESPACE client (2026-09-09). Les deux vides = provisionnement
# eteint, la creation d'agent se comporte comme avant. Une fois posees, la creation d'un agent EXIGE une cle.
# 🔴 VERCEL_API_TOKEN sait FABRIQUER des cles facturees a l'equipe : bien plus dangereux que la cle ci-dessus.
# Poser un plafond d'EQUIPE chez Vercel avant de le renseigner, il borne les degats quoi qu'il arrive.
# ⚠️ Exige aussi ENCRYPTION_KEY (64 hex) : la cle de chaque espace est chiffree au repos.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# Modele de l IA de CONSTRUCTION, a ne pas confondre avec celui d un agent : elle tourne rarement et joue
# le role le plus dur (sortie structuree imbriquee, en francais). Vide -> repli sur LLM_MODEL.
# Mesure le 2026-08-28 sur notre propre schema : zai/glm-4.7 est conforme 4 fois sur 4 et propose a chaque
# fois des regles d arret ET des outils, pour moitie moins cher que deepseek/deepseek-v4-pro (conforme aussi,
# mais qui ne propose jamais d outil). Les modeles « flash » sont instables sur ce role.
AGENT_SETUP_MODEL=zai/glm-4.7
# Modele qui LIT LES IMAGES jointes a la conversation de construction.
# 🔴 SEPARE de AGENT_SETUP_MODEL, et mesure le 2026-08-31 : zai/glm-4.7 REFUSE une part image_url avec un 400
# au corps vide. Reutiliser le modele d entretien livrerait une piece jointe image morte, avec une erreur que
# personne ne saurait lire. Vide = les images sont refusees explicitement ; les documents (texte, PDF, Word)
# passent quand meme, ils n ont besoin d aucun modele. Verifie bon : google/gemini-2.5-flash.
AGENT_VISION_MODEL=google/gemini-2.5-flash
# Modele donne a un agent NEUF : celui qui tournera a CHAQUE message d un contact.
# 🔴 A poser explicitement : le repli sur LLM_MODEL donne l identifiant de l ANALYSE de conversation
# (Anthropic en direct), que le Gateway ne connait pas -> tous les tours de cet agent echoueraient.
# Mesure le 2026-08-28, boucle reelle d outil x5 : zai/glm-4.7-flash rend 15/15 (appelle la recherche,
# reprend le fait rendu, n invente rien sans source), pour 0,000084 $ le tour et 2,2 s. C est le moins cher
# et le plus rapide du banc. deepseek-v4-flash et qwen3.7-flash sont equivalents en qualite, plus chers ou
# plus lents ; kimi-k2.5 perd le fait 2 fois sur 5 et minimax-m3 contredit une source qu il vient de lire.
AGENT_MODEL=zai/glm-4.7-flash
# Taux euros par dollar. Le Gateway facture en DOLLARS, tous nos compteurs sont en micro-euros. C est un
# parametre COMMERCIAL (le client charge et consomme des euros), pas un cours en temps reel.
EUR_PER_USD=0.92
# Notre commission sur le tarif des modeles, en POURCENT, telle qu'elle est ANNONCEE dans la liste
# deroulante de l'onglet Modele d'un agent. AFFICHAGE SEULEMENT : la consommation reellement decomptee
# reste le cout brut du Gateway (cf. src/config.ts). 0 = aucune commission annoncee.
COMMISSION_MODELE_PCT=10

# Support (formulaire de contact -> email via Resend, phase 7)
# Vide -> le formulaire répond 503 (indisponible), pas de crash.
RESEND_API_KEY=
# Expéditeur. `onboarding@resend.dev` marche sans domaine vérifié (mode test : n'envoie QU'à l'adresse
# du compte Resend). Domaine vérifié chez resend.com/domains -> support@messagingme.app.
SUPPORT_FROM=onboarding@resend.dev
# Destinataire des messages du formulaire. Vide -> support indisponible (503).
SUPPORT_TO=

# --- Bascule du front sur Vercel (docs/PLAN-BASCULE-VERCEL-2026-09-03.md) ---
# Les DEUX variables ci-dessous sont VIDES tant que la bascule n'est pas faite, et c'est voulu : vides, le
# comportement est celui d'avant, au caractere pres.

# URL publique de l'API quand elle repond sous SON PROPRE nom, ex. https://api.messagingme.app
# Vide -> tout retombe sur APP_URL. C'est la base des adresses que le produit DISTRIBUE : liens traces /r/,
# visuels RCS /m/, et l'URL /w/ d'un webhook entrant donnee a un tiers.
PUBLIC_API_URL=

# Origines autorisees a appeler l'API depuis un NAVIGATEUR, separees par des virgules.
# Ex. https://engageme.messagingme.app
# Vide -> AUCUN en-tete CORS n'est pose du tout. `*` est REFUSE au demarrage.
CORS_ORIGINS=

# --- Plafonds de debit des routes AUTHENTIFIEES (en appels par minute) ---
# Absentes -> les defauts du code (300 et 10), qui sont ACTIFS : ces plafonds s'appliquent des le
# deploiement, il n'y a rien a poser pour les activer.
# 🔴 Mettre 0 DESACTIVE le plafond concerne. C'est la trappe de secours si le calibrage se revele mauvais
# en production : un `docker compose up -d --force-recreate` va beaucoup plus vite qu'un deploiement de code.

# Plafond general, cle = utilisateur. 300 est tres large pour un humain (la console tire une dizaine
# d'appels en rafale a l'ouverture d'un ecran). Il borne ce qu'un compte authentifie peut couter a Postgres.
RATE_LIMIT_USER_PAR_MINUTE=300

# Plafond des routes COUTEUSES (import CSV, action en masse, purge, export d'historique, lancement de
# campagne), cle = ESPACE et non utilisateur : un espace a dix comptes aurait sinon dix fois le plafond.
RATE_LIMIT_COUTEUX_PAR_MINUTE=10

# Budget de LOOKUPS SPECULATIFS de l'API publique, par minute : combien de bearers JAMAIS RESOLUS ont le
# droit de couter une requete Postgres. Une empreinte deja resolue n'y est plus soumise, donc ce budget ne
# borne que les premiers appels et les tentatives. 🔴 0 DESACTIVE.
# ⚠️ Il est GLOBAL, pas par cle : un compteur par empreinte ne freinerait rien, une rafale de cles toutes
# differentes produisant autant de compteurs a 1 (mesure).
API_KEY_PREFILTRE_MAX=30

# Combien d'operations LOURDES de l'API publique (lot de contacts, creation d'envoi) peuvent etre en vol
# en meme temps, TOUS CLIENTS CONFONDUS. 🔴 Le chiffre se CALCULE : le pool porte DB_POOL_MAX=8 connexions
# pour tout le process, un lot en demande jusqu'a 4, donc UN lot en prend la moitie et le suivant recoit un
# 429 avec Retry-After. Deux saturaient le pool, et avec lui la console et la reception des messages.
# Le calcul et son historique font foi dans src/config.ts. 0 DESACTIVE.
API_MAX_LOURDES_SIMULTANEES=1

# Rappels smsmode (/rcs/callback/:code) acceptes par minute et PAR CODE existant : ce qu'un code qui fuite peut
# ecrire. Il se CALCULE sur le debit RCS (jusqu'a trois accuses par message) : le calcul fait foi dans
# src/config.ts, et un test tient l'ecart. Un refus est un 429, que smsmode rejoue. 0 DESACTIVE.
RCS_CALLBACK_PAR_MINUTE=3000

# Codes d'URL JAMAIS VUS (/w/:code, /rcs/callback/:code) qu'on accepte d'aller lire en base, par minute et par
# porte, tous appelants confondus : la borne des codes inventes. Un code deja resolu n'y est plus soumis.
# Le raisonnement fait foi dans src/config.ts. 0 DESACTIVE.
CODES_INCONNUS_PAR_MINUTE=120

# --- Bornes des champs personnalises pousses par l'API publique (/v1/contacts) ------------------
# Absentes -> les defauts du code (64, 50, 200), qui sont ACTIFS.
# Mesure du 2026-09-14 en production : 10 definitions de champs sur l'ensemble des espaces, la plus
# longue cle fait 11 caracteres, aucun contact n'en porte plus de 6. Ces defauts sont donc entre 5 et
# 20 fois au-dessus de l'usage reel : un integrateur normal ne les rencontre pas.

# Longueur maximale du NOM d'un champ envoye par l'API.
API_MAX_CLE_CHAMP=64

# Combien de champs UN contact peut porter dans UNE requete.
API_MAX_CHAMPS_PAR_CONTACT=50

# Combien de definitions de champs un ESPACE peut porter au total. Au plafond, l'API refuse d'en CREER
# une de plus (les champs deja declares continuent de passer normalement).
# 🔴 0 DESACTIVE ce plafond, comme les plafonds de debit ci-dessus.
API_MAX_CHAMPS_PAR_ESPACE=200

# Ce que NOUS depensons par espace et par mois pour les assistants de configuration (MBA, agents IA).
# 0 desactive le plafond. ⚠️ Ce n'est PAS le plafond d'equipe Vercel, qui couperait tous les bots clients.
ASSISTANT_PLAFOND_EUROS_MOIS=2
