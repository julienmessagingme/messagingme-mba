{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "P=\"$VERCEL_GIT_PREVIOUS_SHA\"; [ -n \"$P\" ] || exit 1; git cat-file -e \"$P\" 2>/dev/null || GIT_TERMINAL_PROMPT=0 git fetch --depth=1 https://github.com/julienmessagingme/messagingme-mba \"$P\" || exit 1; git diff --quiet \"$P\" HEAD -- ./ && exit 0; exit 1",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:chemin(.*)",
      "has": [
        {
          "type": "host",
          "value": "engageme-site.vercel.app"
        }
      ],
      "destination": "https://app.messagingme.fr/:chemin",
      "permanent": true
    },
    {
      "source": "/:chemin(.*)",
      "has": [
        {
          "type": "host",
          "value": "engageme.messagingme.fr"
        }
      ],
      "destination": "https://app.messagingme.fr/:chemin",
      "permanent": true
    },
    {
      "source": "/industries/",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/en/industries/",
      "destination": "/en/solutions/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:dossier*/index.html",
      "destination": "/:dossier*/",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "/tarifs/",
      "permanent": true
    },
    {
      "source": "/cas-d-usage",
      "destination": "/solutions/saas-et-app-builders/",
      "permanent": true
    },
    {
      "source": "/cas-d-usage/",
      "destination": "/solutions/saas-et-app-builders/",
      "permanent": true
    },
    {
      "source": "/en/use-cases",
      "destination": "/en/solutions/saas-and-app-builders/",
      "permanent": true
    },
    {
      "source": "/en/use-cases/",
      "destination": "/en/solutions/saas-and-app-builders/",
      "permanent": true
    },
    {
      "source": "/whatsapp",
      "destination": "https://wa.me/33525680250?text=Bonjour%2C%20je%20viens%20du%20livre%20blanc%20Recruter%20sur%20WhatsApp",
      "permanent": false
    },
    {
      "source": "/whatsapp/",
      "destination": "https://wa.me/33525680250?text=Bonjour%2C%20je%20viens%20du%20livre%20blanc%20Recruter%20sur%20WhatsApp",
      "permanent": false
    },
    {
      "source": "/en/whatsapp",
      "destination": "https://wa.me/33525680250?text=Hi%2C%20I%20just%20read%20the%20white%20paper%20Recruiting%20on%20WhatsApp",
      "permanent": false
    },
    {
      "source": "/en/whatsapp/",
      "destination": "https://wa.me/33525680250?text=Hi%2C%20I%20just%20read%20the%20white%20paper%20Recruiting%20on%20WhatsApp",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(img|films)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/livre-blanc/(.*).pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
